# ---------- Server ----------
NODE_ENV=development
PORT=4000
# info | debug | warn | error | silent
LOG_LEVEL=info
# Number of proxies in front of the API (0 locally, 1 on Vercel/Render)
TRUST_PROXY=0

# ---------- Database (PostgreSQL) ----------
# Pooled connection used by the app at runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectflow?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/projectflow?schema=public

# ---------- Auth ----------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
# Access token lifetime in seconds (900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# Secure flag on the refresh cookie. Defaults to true in production; false is fine for http://localhost
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ---------- CORS ----------
# Comma-separated list of web origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# ---------- Rate limiting ----------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_API_MAX=300
